---
import { getCollection } from 'astro:content';
import {
    Hero,
    Values,
    Roadmaps,
    Blogs,
    Videos,
} from '@/partials/Landing';
import { Statement } from '@/partials/Statement';
import Base from '@/templates/Base.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '@/consts';

const roadmaps = await getCollection('roadmap');
---

<Base title={SITE_TITLE} description={SITE_DESCRIPTION}>
    <Hero />
    <Statement client:load />
    <Values />
    <Roadmaps roadmaps={roadmaps} />
    <Blogs client:load />
    <Videos client:load />
</Base>
