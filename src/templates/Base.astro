---
import { Footer } from '@/partials/Footer';
import { Navigation } from '@/partials/Navigation';
import BaseHead from '@/templates/BaseHead.astro';

export interface Props {
    title: string;
    description: string;
    hideNav?: boolean;
    hideFooter?: boolean;
    image?: string;
}

const { title, description, hideNav, hideFooter, image } = Astro.props;
---

<html lang="th">
    <head>
        <BaseHead title={title} description={description} image={image} />
    </head>
    <body class="bg-bg-primary text-text-primary">
        <a
            href="#main"
            class="sr-only focus:not-sr-only focus:fixed focus:left-2 focus:top-2 focus:z-[100] focus:rounded-lg focus:bg-accent-primary focus:px-4 focus:py-2 focus:font-semibold focus:text-black"
        >
            Skip to content
        </a>
        {!hideNav && <Navigation client:load pathname={Astro.url.pathname} />}
        <main id="main" class="min-h-screen">
            <slot />
        </main>

        {!hideFooter && <Footer />}

        <!-- Google tag (gtag.js) -->
        <script
            async
            src="https://www.googletagmanager.com/gtag/js?id=G-D28VR1K58G"
        ></script>
        <script is:inline>
            window.dataLayer = window.dataLayer || [];
            function gtag() {
                dataLayer.push(arguments);
            }
            gtag('js', new Date());

            gtag('config', 'G-D28VR1K58G');
        </script>
    </body>
</html>
